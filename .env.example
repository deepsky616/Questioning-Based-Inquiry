DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
# migrate 명령용 직접 연결(세션 모드, 포트 5432) — transaction 풀러(6543)로는 migrate가 실패한다
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# 에러 모니터링(Sentry) — 선택. 비워두면 모니터링 전체가 no-op으로 동작한다
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# 로컬에서 next start(프로덕션 모드)로 검증할 때 필요 — 없으면 모든 /api/auth/*가 500(UntrustedHost). Vercel은 자동 설정
AUTH_TRUST_HOST="true"
GOOGLE_API_KEY="your-gemini-api-key"

# Vercel 예약 작업이 질문놀이 임시 방 정리 경로를 호출할 때 사용하는 비밀값입니다.
CRON_SECRET="replace-with-a-long-random-secret"

# 질문놀이 활동 내용 해시 전용 비밀값입니다. 운영 환경에서는 반드시 별도로 설정합니다.
GAME_ACTIVITY_HASH_SECRET="replace-with-another-long-random-secret"

# Gmail SMTP. Both values must belong to the same Google account.
# Optional for local development; required for password reset email in deployed environments.
# App password: myaccount.google.com → Security → App passwords
GMAIL_USER="your_gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
