generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // migrate 계열 명령용 직접 연결(세션 모드) — transaction 풀러(6543)는
  // prepared statement를 지원하지 않아 schema engine이 실패한다.
  directUrl = env("DIRECT_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String? @unique @map("email")
  password String  @map("password")
  name     String  @map("name")
  role     String  @map("role")

  grade         String? @map("grade")
  className     String? @map("class_name")
  studentNumber String? @map("student_number")

  school String? @map("school")

  // 교사별 AI 설정(자신의 담당 학급 학생과 공유)
  aiApiKey String? @map("ai_api_key")
  aiModel  String? @map("ai_model")

  totalPoints Int @default(0) @map("total_points")

  questions           Question[]           @relation("QuestionAuthor")
  comments            Comment[]            @relation("CommentAuthor")
  sessions            QuestionSession[]    @relation("SessionTeacher")
  teacherClasses      TeacherClass[]       @relation("TeacherClasses")
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetTokens")
  unitDesigns         UnitDesign[]         @relation("UnitDesigns")
  questionLikes       QuestionLike[]       @relation("UserLikes")
  pointLogs           PointLog[]           @relation("StudentPointLogs")
  activityAwardClaims ActivityAwardClaim[] @relation("StudentActivityAwardClaims")
  awardedLogs         PointLog[]           @relation("AwardedByTeacher")
  gameRoomCreateAttempts GameRoomCreateAttempt[] @relation("GameRoomCreateAttempts")
  ownedGameRuns       GameRun[]            @relation("GameRunOwner")
  gameActivities      GameActivity[]       @relation("GameActivityActor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role, grade, className])
  @@index([role, school, grade, className])
  @@index([role, totalPoints])
  @@index([role, school, totalPoints])
  @@map("users")
}

model PointLog {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  student     User     @relation("StudentPointLogs", fields: [studentId], references: [id], onDelete: Cascade)
  gameId      String   @map("game_id")
  roomCode    String?  @map("room_code")
  bonusType   String   @map("bonus_type")
  points      Int      @map("points")
  reason      String   @default("") @map("reason")
  status      String   @default("APPROVED") @map("status")
  sessionId   String?  @map("session_id_ref")
  relatedQuestionId String? @map("related_question_id")
  relatedCommentId  String? @map("related_comment_id")
  activityDedupeKey String? @map("activity_dedupe_key")
  aiAnalysis  String?  @map("ai_analysis")
  awardedById String?  @map("awarded_by_id")
  awardedBy   User?    @relation("AwardedByTeacher", fields: [awardedById], references: [id])
  decidedById String?  @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")
  gameRunId   String?  @map("game_run_id")
  gameRun     GameRun? @relation("GameRunPointLogs", fields: [gameRunId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([studentId, gameId, roomCode, bonusType], name: "uniq_point_award")
  @@unique([relatedQuestionId, bonusType], name: "uniq_point_per_question")
  @@unique([relatedCommentId, bonusType], name: "uniq_point_per_comment")
  @@unique([studentId, bonusType, activityDedupeKey], name: "uniq_activity_content_award", map: "uniq_activity_content_award")
  @@unique([studentId, gameRunId, bonusType], name: "uniq_point_per_game_run")
  @@index([studentId, createdAt])
  @@index([gameId, createdAt])
  @@index([gameRunId])
  @@index([status])
  @@index([sessionId])
  @@map("point_logs")
}

model ActivityAwardClaim {
  studentId          String   @map("student_id")
  student            User     @relation("StudentActivityAwardClaims", fields: [studentId], references: [id], onDelete: Cascade)
  bonusType          String   @map("bonus_type")
  activityDedupeKey  String   @map("activity_dedupe_key")
  scopeId            String   @map("scope_id")
  pointLogId         String   @map("point_log_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@id([studentId, bonusType, activityDedupeKey], map: "activity_award_claims_pkey")
  @@unique([pointLogId], map: "uniq_activity_award_claim_point_log")
  @@map("activity_award_claims")
}

model AppNotification {
  id          String    @id @default(cuid())
  recipientId String    @map("recipient_id")
  senderId    String?   @map("sender_id")
  sessionId   String?   @map("session_id")
  type        String    @default("SESSION_REMINDER") @map("type")
  title       String    @map("title")
  message     String    @default("") @map("message")
  href        String?   @map("href")
  metadata    Json      @default("{}") @map("metadata")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([recipientId, senderId, sessionId, type], name: "uniq_app_notification_once")
  @@index([recipientId, readAt, createdAt])
  @@index([senderId])
  @@index([sessionId])
  @@map("app_notifications")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation("PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model TeacherClass {
  id        String @id @default(cuid())
  teacherId String @map("teacher_id")
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  grade     String @map("grade")
  className String @map("class_name")

  @@unique([teacherId, grade, className])
  @@map("teacher_classes")
}

model QuestionSession {
  id              String     @id @default(cuid())
  date            String     @map("session_date")
  subject         String     @map("subject")
  topic           String     @default("") @map("topic")
  targetType      String     @default("ALL") @map("target_type")
  targetGrade     String?    @map("target_grade")
  targetClassName String?    @map("target_class_name")
  targetStudentId String?    @map("target_student_id")
  targetStudentIds Json      @default("[]") @map("target_student_ids")
  teacherId       String     @map("teacher_id")
  teacher         User       @relation("SessionTeacher", fields: [teacherId], references: [id])
  questions       Question[] @relation("SessionQuestions")
  unitDesignId    String?    @map("unit_design_id")
  sharedQuestions Json       @default("[]") @map("shared_questions")
  defaultQuestionPublic Boolean @default(true) @map("default_question_public")
  likesVisibleToPeers Boolean @default(true) @map("likes_visible_to_peers")
  commentsVisibleToPeers Boolean @default(true) @map("comments_visible_to_peers")
  isActive        Boolean    @default(true)  @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([teacherId, createdAt])
  @@index([targetType, targetGrade, targetClassName])
  @@map("question_sessions")
}

model Question {
  id             String  @id @default(cuid())
  content        String  @map("content")
  normalizedContent String @default("") @map("normalized_content")
  dedupeKey      String? @map("dedupe_key")
  closure        String  @map("closure")
  cognitive      String  @map("cognitive")
  closureScore   Float?  @map("closure_score")
  cognitiveScore Float?  @map("cognitive_score")
  context        String? @map("context")
  source         String  @default("STUDENT") @map("source")
  inquiryType    String? @map("inquiry_type")

  sessionId String?          @map("session_id")
  session   QuestionSession? @relation("SessionQuestions", fields: [sessionId], references: [id])

  authorId String    @map("author_id")
  author   User      @relation("QuestionAuthor", fields: [authorId], references: [id])
  comments Comment[] @relation("QuestionComments")
  likes    QuestionLike[] @relation("QuestionLikes")

  isPublic  Boolean  @default(false) @map("is_public")
  flagged    Boolean @default(false) @map("flagged")
  flagReason String? @map("flag_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, authorId, dedupeKey], name: "uniq_student_question_content", map: "uniq_student_question_content")
  @@index([authorId, createdAt])
  @@index([sessionId, source])
  @@index([sessionId, createdAt])
  @@map("questions")
}

model Comment {
  id         String   @id @default(cuid())
  content    String   @map("content")
  normalizedContent String @default("") @map("normalized_content")
  dedupeKey  String? @map("dedupe_key")
  authorId   String   @map("author_id")
  author     User     @relation("CommentAuthor", fields: [authorId], references: [id])
  questionId String   @map("question_id")
  question   Question @relation("QuestionComments", fields: [questionId], references: [id])
  flagged    Boolean  @default(false) @map("flagged")
  flagReason String?  @map("flag_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([questionId, authorId, dedupeKey], name: "uniq_student_comment_content", map: "uniq_student_comment_content")
  @@index([authorId, createdAt])
  @@map("comments")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique @map("config_key")
  value     String   @map("config_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model GameRoom {
  code      String   @id @map("code")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  presences GameRoomPresence[]

  @@index([updatedAt])
  @@map("game_rooms")
}

model GameRoomPresence {
  roomCode      String   @map("room_code")
  roomCreatedAt BigInt   @map("room_created_at")
  userId        String   @map("user_id")
  lastSeenAt    DateTime @map("last_seen_at")
  room          GameRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@id([roomCode, roomCreatedAt, userId])
  @@index([lastSeenAt])
  @@map("game_room_presences")
}

model GameRoomCreateAttempt {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  user      User     @relation("GameRoomCreateAttempts", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("game_room_create_attempts")
}

model GameRoomSettlement {
  gameId       String   @map("game_id")
  awardKey     String   @map("award_key")
  roomCode     String?  @map("room_code")
  roomCreatedAt BigInt? @map("room_created_at")
  playId       String?  @map("play_id")
  outcome      String   @map("outcome")
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([gameId, awardKey], map: "game_room_settlements_pkey")
  @@map("game_room_settlements")
}

model GameRun {
  id                         String         @id @default(cuid())
  gameId                     String         @map("game_id")
  mode                       String         @map("mode")
  ownerId                    String?        @map("owner_id")
  owner                      User?          @relation("GameRunOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creationRequestId          String         @map("creation_request_id")
  creationRequestFingerprint String         @map("creation_request_fingerprint")
  roomLifetimeKey            String?        @unique @map("room_lifetime_key")
  participants               Json           @default("[]") @map("participants")
  status                     String         @default("ACTIVE") @map("status")
  state                      Json           @map("state")
  version                    Int            @default(1) @map("version")
  scoreDate                  String?        @map("score_date")
  completedAt                DateTime?      @map("completed_at")
  settledAt                  DateTime?      @map("settled_at")
  expiresAt                  DateTime       @map("expires_at")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")
  activities                 GameActivity[]
  pointLogs                  PointLog[]     @relation("GameRunPointLogs")

  @@unique([ownerId, creationRequestId], name: "uniq_game_run_creation_request")
  @@index([ownerId, status, updatedAt])
  @@index([ownerId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt, id])
  @@index([mode, scoreDate])
  @@map("game_runs")
}

model GameActivity {
  id                 String   @id @default(cuid())
  runId              String   @map("run_id")
  run                GameRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  actorId            String?  @map("actor_id")
  actor              User?    @relation("GameActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  requestId          String   @map("request_id")
  requestFingerprint String   @map("request_fingerprint")
  sequence           Int      @map("sequence")
  type               String   @map("type")
  payload            Json     @map("payload")
  validQuestionCount Int      @default(0) @map("valid_question_count")
  scoreValue         Int      @default(0) @map("score_value")
  responseSnapshot   Json     @map("response_snapshot")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([runId, requestId], name: "uniq_game_activity_request")
  @@unique([runId, sequence], name: "uniq_game_activity_sequence")
  @@index([actorId, createdAt])
  @@index([runId, type])
  @@map("game_activities")
}

model QuestionGameCustom {
  id          String   @id @map("id")
  teacherId   String   @map("teacher_id")
  title       String   @map("title")
  description String   @db.Text @map("description")
  emoji       String   @map("emoji")
  gradientCss String   @db.Text @map("gradient_css")
  accentColor String   @default("#6366f1") @map("accent_color")
  playerCount String   @default("제한없음") @map("player_count")
  duration    String   @default("20분") @map("duration")
  instructions Json    @default("[]") @map("instructions")
  order       Int      @default(100) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([teacherId, order])
  @@map("question_game_customs")
}

model QuestionGameVisibility {
  teacherId  String   @map("teacher_id")
  gameId     String   @map("game_id")
  visibility Json     @map("visibility")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([teacherId, gameId])
  @@index([teacherId])
  @@map("question_game_visibilities")
}

model QuestionGameOrder {
  teacherId String   @id @map("teacher_id")
  gameIds   Json     @default("[]") @map("game_ids")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("question_game_orders")
}

// 교사 커스텀 연습 문항 — 내장 은행(question-practice-data.ts)은 검수본 그대로 두고,
// 교사가 추가한 문항이 담당 학급 학생의 질문 연습에 저장 즉시 병합된다.
model PracticeCustomItem {
  id        String  @id @default(cuid()) @map("id")
  teacherId String  @map("teacher_id")
  mode      String  @map("mode") // quiz | transform | create
  // quiz — 분류 연습
  content     String? @db.Text @map("content")
  closure     String? @map("closure") // closed | open
  cognitive   String? @map("cognitive") // factual | conceptual | controversial
  explanation String? @db.Text @map("explanation")
  // transform — 질문 바꾸기
  source  String? @db.Text @map("source")
  target  String? @map("target") // open | conceptual | controversial
  hint    String? @db.Text @map("hint")
  example String? @db.Text @map("example")
  // create — 질문 만들기
  title   String? @map("title")
  passage String? @db.Text @map("passage")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId, mode])
  @@map("practice_custom_items")
}

// 질문 연습 시도 기록 — 정답·오답 모두 남겨 문항별 정답률과 학생별
// 취약 유형 분석의 재료가 된다(포인트 지급 기록과 달리 오답도 기록).
// 학생 시도만 기록한다(교사의 '직접 해보기'는 제외).
model PracticeAttempt {
  id        String   @id @default(cuid()) @map("id")
  studentId String   @map("student_id")
  mode      String   @map("mode") // quiz | transform | create | transform-ai | create-ai
  itemId    String?  @map("item_id") // 은행·커스텀 문항 id (AI 실시간 출제는 null)
  quizType  String?  @map("quiz_type") // closure | cognitive (quiz 전용)
  correct   Boolean  @map("correct") // quiz 정답 / transform·create 목표 달성
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@index([studentId, createdAt])
  @@map("practice_attempts")
}

// 2022 개정 교육과정 시드 데이터
model CurriculumArea {
  id             String   @id @default(cuid())
  subject        String   @map("subject")        // "과학", "사회", "국어" …
  gradeRange     String   @map("grade_range")    // "1-2", "3-4", "5-6"
  area           String   @map("area")           // 영역명 ("생명", "물질" …)
  coreIdea       String   @db.Text @map("core_idea")
  knowledgeItems       Json  @map("knowledge_items")        // 지식·이해 내용요소 (해당 학년군)
  processItems         Json  @map("process_items")          // 과정·기능 내용요소 (해당 학년군)
  valueItems           Json  @map("value_items")            // 가치·태도 내용요소 (해당 학년군)
  middleKnowledgeItems Json? @map("middle_knowledge_items") // 중학교 지식·이해 (선행 확인용)
  middleProcessItems   Json? @map("middle_process_items")   // 중학교 과정·기능 (선행 확인용)
  middleValueItems     Json? @map("middle_value_items")     // 중학교 가치·태도 (선행 확인용)
  achievements         Json  @map("achievements")           // [{code, content}] 성취기준
  units                Json  @default("[]") @map("units")  // [{unitCode, unitName}] 영역 내 단원 목록

  unitDesigns    UnitDesign[]

  @@index([subject, gradeRange])
  @@map("curriculum_areas")
}

// 교사가 생성·저장한 단원 설계
model UnitDesign {
  id                 String          @id @default(cuid())
  teacherId          String          @map("teacher_id")
  teacher            User            @relation("UnitDesigns", fields: [teacherId], references: [id], onDelete: Cascade)
  curriculumAreaId   String?         @map("curriculum_area_id")
  curriculumArea     CurriculumArea? @relation(fields: [curriculumAreaId], references: [id])

  title              String          @map("title")
  subject            String          @map("subject")
  gradeRange         String          @map("grade_range")
  grade              String?         @map("grade")          // 개별 학년(저장 시 선택)
  sessionDate        String?         @map("session_date")   // 수업 예정 날짜(저장 시 선택)
  area               String          @map("area")
  coreIdea           String          @db.Text @map("core_idea")
  selectedKeywords   Json            @map("selected_keywords")   // string[]
  coreSentences      Json            @map("core_sentences")      // string[]
  essentialQuestions Json            @map("essential_questions") // string[]
  inquiryQuestions   Json            @map("inquiry_questions")   // [{type, content}][]

  // 수업세션 기본 공개 설정(저장 탭 수정 시 기본값으로 반영)
  isActive               Boolean     @default(true) @map("is_active")
  defaultQuestionPublic  Boolean     @default(true) @map("default_question_public")
  likesVisibleToPeers    Boolean     @default(true) @map("likes_visible_to_peers")
  commentsVisibleToPeers Boolean     @default(true) @map("comments_visible_to_peers")
  // 배포 대상(SessionTargetSelector 선택값 그대로 저장 → 수정 시 복원)
  targetClassValue       String      @default("all") @map("target_class_value")
  targetStudentIds       Json        @default("[]") @map("target_student_ids")

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("unit_designs")
}

model QuestionLike {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation("QuestionLikes", fields: [questionId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([questionId, userId])
  @@index([questionId])
  @@index([userId, createdAt])
  @@map("question_likes")
}

// 사용자 콘텐츠(질문·댓글) 번역 캐시. 원문은 Question/Comment에 그대로 보존하고
// 번역문만 여기에 (sourceType, sourceId, targetLocale)별로 저장해 모든 뷰어가 공유한다.
// sourceHash는 원문의 해시로, 원문이 수정되면 stale 번역을 폐기·재생성하는 데 쓴다.
model Translation {
  id           String   @id @default(cuid())
  sourceType   String   @map("source_type") // "QUESTION" | "COMMENT"
  sourceId     String   @map("source_id")
  targetLocale String   @map("target_locale") // "en" …
  content      String   @db.Text @map("content")
  sourceHash   String   @map("source_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceType, sourceId, targetLocale])
  @@index([sourceType, sourceId])
  @@map("translations")
}

// 수업 세션 AI 분석 결과 영속화 — 어느 브라우저·기기에서든 마지막 분석을 그대로 보여주기 위함.
// scope="class"는 세션 전체 분석(studentId=""), scope="student"는 특정 학생 분석(studentId=학생 id).
model SessionAnalysis {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  scope     String   @map("scope")
  studentId String   @default("") @map("student_id") // student scope에서만 사용, class는 ""
  result    Json     @map("result") // SessionAnalysisResult 형태
  locale    String   @default("") @map("locale") // 생성 시 언어(참고용)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, scope, studentId])
